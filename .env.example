# WorkSphere - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local development.

# ==============================================================================
# 1. APPLICATION & PROFILE
# ==============================================================================
# [OPTIONAL_WITH_SAFE_DEFAULT] Active Spring profile (dev, test, prod). Default: dev
SPRING_PROFILES_ACTIVE=dev

# [OPTIONAL_WITH_SAFE_DEFAULT] Port for Spring Boot server inside container. Default: 8080
SERVER_PORT=8080

# [OPTIONAL_WITH_SAFE_DEFAULT] Exposed Actuator management endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# ==============================================================================
# 2. DOCKER COMPOSE ORCHESTRATION (Local Development)
# ==============================================================================
# [OPTIONAL_WITH_SAFE_DEFAULT] Project namespace for container and network naming
COMPOSE_PROJECT_NAME=worksphere

# [OPTIONAL_WITH_SAFE_DEFAULT] Host port mapped to Backend (127.0.0.1:8080)
# Use http://localhost:8080 to access backend from host.
BACKEND_PORT=8080

# [OPTIONAL_WITH_SAFE_DEFAULT] Host port mapped to PostgreSQL (127.0.0.1:5433)
# NOTE: Internal backend container connects to postgres:5432 directly.
# Port 5433 is for optional host tools (e.g. DBeaver, psql, pgAdmin) to avoid
# conflicting with any host PostgreSQL or legacy worksphere-dev-pg (5432).
POSTGRES_HOST_PORT=5433

# ==============================================================================
# 3. DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# [REQUIRED_NON_SECRET] Target database name inside PostgreSQL container
POSTGRES_DB=worksphere

# [REQUIRED_NON_SECRET] PostgreSQL username
POSTGRES_USER=worksphere_user

# [REQUIRED_SECRET] PostgreSQL password - MUST BE SUPPLIED BY USER.
# Replace with a strong custom password. Do not commit real passwords.
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_chars

# Host-level Database Variables (Used by host dev tools when connecting from outside Docker)
# When running tools on Windows host connecting to Docker PostgreSQL:
# Host: localhost, Port: 5433 (maps to container 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=worksphere
DB_USER=worksphere_user
DB_PASSWORD=replace_with_strong_password_minimum_16_chars
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ==============================================================================
# 4. SECURITY & JWT AUTHENTICATION
# ==============================================================================
# [REQUIRED_SECRET] Secret key for HMAC-SHA256 signing - MUST BE AT LEAST 32 CHARACTERS (256 bits).
# Compose maps this directly to worksphere.jwt.secret in Spring Boot.
# Replace with a strong random string. Do not commit real secret keys.
JWT_SECRET_KEY=replace_with_strong_random_jwt_secret_key_minimum_32_characters

# [OPTIONAL_WITH_SAFE_DEFAULT] Token validity in seconds (900s = 15m, 2592000s = 30d)
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# ==============================================================================
# 5. FILE STORAGE CONFIGURATION
# ==============================================================================
# [OPTIONAL_WITH_SAFE_DEFAULT] Storage directory inside backend container
# Mapped to named volume 'worksphere-uploads' in Docker Compose.
WORKSPHERE_STORAGE_PATH=/app/uploads

# Host path when running backend directly without Docker (local dev fallback)
FILE_STORAGE_DIR=./uploads
FILE_MAX_SIZE_BYTES=20971520

# ==============================================================================
# 6. MOBILE API BASE URL
# ==============================================================================
# For Android Emulator, use 10.0.2.2 to access host machine:
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/v1
# For iOS Simulator:
# MOBILE_API_BASE_URL=http://localhost:8080/api/v1
